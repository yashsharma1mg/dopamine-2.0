{
  "name": "@internal/design-system",
  "version": "0.1.0",
  "description": "Internal React component library and design tokens.",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/Button.d.ts",
      "import": "./dist/Button.js"
    },
    "./tokens": {
      "types": "./dist/generated/tokens.d.ts",
      "import": "./dist/generated/tokens.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
